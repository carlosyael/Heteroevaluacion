@page "/maestro"
@rendermode InteractiveServer
@implements IDisposable
@using HeteroevaluacionApp.Models
@using HeteroevaluacionApp.Services
@inject StudentImportService ImportService
@inject EvaluationService EvalService
@inject SessionService Session
@inject IJSRuntime JS

<PageTitle>Backoffice Maestro - Heteroevaluación</PageTitle>

@if (!Session.IsTeacherAuthenticated)
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card portal-card-teacher">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-2" style="color: #1F3864;">Backoffice del Maestro</h3>
                        <p class="text-muted small mb-4">
                            Ingresa el PIN de docente para gestionar estudiantes y consultar resultados.
                        </p>

                        @if (!string.IsNullOrEmpty(_pinError))
                        {
                            <div class="alert alert-danger py-2">@_pinError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">PIN de Acceso</label>
                            <input type="password" class="form-control form-control-lg"
                                   placeholder="PIN docente"
                                   @bind="_pinInput"
                                   @bind:event="oninput"
                                   @onkeydown="HandlePinKeyDown" />
                        </div>

                        <button class="btn btn-accent w-100 btn-lg" @onclick="VerifyPin">
                            Ingresar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h2 class="fw-bold mb-0">Backoffice del Maestro</h2>
                <span class="text-muted small">Gestión de estudiantes y resultados de heteroevaluación</span>
            </div>
            <button class="btn btn-outline-secondary" @onclick="LogoutTeacher">Cerrar sesión</button>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <h5 class="fw-bold mb-0">Orquestación de Evaluación</h5>
                    @if (_evalState.IsOpen && _activeStudent != null)
                    {
                        <span class="badge bg-success fs-6">
                            ACTIVA: @_activeStudent.Nombre (@_activeStudent.Id)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">EVALUACIÓN CERRADA</span>
                    }
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Estudiante a evaluar</label>
                        <select class="form-select" @bind="_selectedActiveStudentId">
                            <option value="">-- Selecciona un estudiante --</option>
                            @foreach (var s in _students)
                            {
                                <option value="@s.Id">@s.Id - @s.Nombre (@s.Carrera)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-success w-100"
                                @onclick="StartEvaluationAsync"
                                disabled="@string.IsNullOrEmpty(_selectedActiveStudentId)">
                            Iniciar Evaluación
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-danger w-100"
                                @onclick="CloseEvaluationAsync"
                                disabled="@(!_evalState.IsOpen)">
                            Cerrar Evaluación
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_orchestrationMessage))
                {
                    <div class="alert alert-info py-2 small mt-3 mb-0">@_orchestrationMessage</div>
                }

                @if (_evalState.IsOpen && _activeStudent != null)
                {
                    double pctDone = _activeEligibleCount > 0 ? (_activeReceivedCount * 100.0 / _activeEligibleCount) : 0;
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="small fw-semibold" style="color: #1F3864;">
                                Progreso en vivo: @_activeReceivedCount / @_activeEligibleCount evaluaciones recibidas
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border">En vivo &middot; actualización automática</span>
                                @if (_pendingEvaluators.Count > 0)
                                {
                                    <button class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => _showPendingList = !_showPendingList">
                                        @(_showPendingList ? "Ocultar pendientes" : $"Ver pendientes ({_pendingEvaluators.Count})")
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width: @pctDone.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>

                        @if (_showPendingList && _pendingEvaluators.Count > 0)
                        {
                            <div class="mt-2 d-flex flex-wrap gap-1">
                                @foreach (var pend in _pendingEvaluators)
                                {
                                    <span class="badge bg-warning text-dark">@pend.Id - @pend.Nombre</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == 0 ? "active fw-bold" : "")" @onclick="() => SwitchTab(0)">
                    Estudiantes y Carga Masiva (@_students.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == 1 ? "active fw-bold" : "")" @onclick="() => SwitchTab(1)">
                    Resultados y Promedios
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == 2 ? "active fw-bold" : "")" @onclick="() => SwitchTab(2)">
                    Configuración y Reseteo
                </button>
            </li>
        </ul>

        @if (_activeTab == 0)
        {
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <h5 class="fw-bold mb-2">Cargar Estudiantes (CSV o Excel)</h5>
                            <p class="text-muted small mb-3">
                                El archivo debe tener las columnas: <code>Id</code>, <code>Nombre</code>, <code>Carrera</code>, <code>TemaTesis</code>.
                            </p>

                            <InputFile OnChange="HandleFileUpload" accept=".csv,.xlsx,.xls" class="form-control mb-3" />

                            @if (_isUploading)
                            {
                                <div class="text-primary small mb-2">Procesando archivo...</div>
                            }

                            @if (_importResult != null)
                            {
                                <div class="alert alert-info py-2 small">
                                    <strong>Importación completada:</strong>
                                    @_importResult.Added agregados, @_importResult.Updated actualizados.
                                    @if (_importResult.Errors.Count > 0)
                                    {
                                        <ul class="mb-0 mt-1 text-danger">
                                            @foreach (var err in _importResult.Errors.Take(5))
                                            {
                                                <li>@err</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }

                            <button class="btn btn-outline-primary btn-sm" @onclick="DownloadTemplateAsync">
                                Descargar Plantilla Excel (.xlsx)
                            </button>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Agregar / Actualizar Estudiante</h5>

                            @if (!string.IsNullOrEmpty(_formMessage))
                            {
                                <div class="alert alert-success py-2 small">@_formMessage</div>
                            }

                            <div class="mb-2">
                                <label class="form-label small fw-semibold">ID (Matrícula)</label>
                                <input type="text" class="form-control" @bind="_newStudent.Id" placeholder="Ej. 20210001" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Nombre Completo</label>
                                <input type="text" class="form-control" @bind="_newStudent.Nombre" placeholder="Ej. Ana García" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Carrera</label>
                                <input type="text" class="form-control" @bind="_newStudent.Carrera" placeholder="Ej. Ing. en Sistemas" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tema de Tesis</label>
                                <textarea class="form-control" rows="2" @bind="_newStudent.TemaTesis" placeholder="Título del tema de tesis"></textarea>
                            </div>
                            <button class="btn btn-primary w-100" @onclick="SaveStudentAsync">
                                Guardar Estudiante
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Listado de Estudiantes</h5>
                                <input type="text" class="form-control form-control-sm w-50"
                                       placeholder="Buscar por ID o nombre..."
                                       @bind="_searchTerm" @bind:event="oninput" />
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Nombre</th>
                                            <th>Carrera</th>
                                            <th>Tema de Tesis</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in FilteredStudents)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">@s.Id</span></td>
                                                <td class="fw-semibold">@s.Nombre</td>
                                                <td>@s.Carrera</td>
                                                <td>@s.TemaTesis</td>
                                                <td class="text-end">
                                                    @if (_confirmDeleteStudentId == s.Id)
                                                    {
                                                        <div class="d-flex justify-content-end gap-1">
                                                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteStudentAsync(s.Id)">
                                                                Confirmar
                                                            </button>
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteStudentId = null">
                                                                Cancelar
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmDeleteStudentId = s.Id">
                                                            Eliminar
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == 1)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <h5 class="fw-bold mb-0">Resumen de Calificaciones</h5>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-light text-dark border">Auto-refresco 5s</span>
                    <button class="btn btn-outline-primary btn-sm" @onclick="RefreshResultsAsync">
                        Refrescar
                    </button>
                    <button class="btn btn-success btn-sm" @onclick="ExportExcelAsync">
                        Exportar Resultados (.xlsx)
                    </button>
                    <button class="btn btn-primary btn-sm"
                            disabled="@(!_summaries.Any(s => s.EvaluationsReceivedCount > 0))"
                            @onclick="ExportAllRubricsZipAsync">
                        Rúbricas (.zip)
                    </button>
                    @if (!_confirmDeleteAllEvals)
                    {
                        <button class="btn btn-outline-danger btn-sm"
                                disabled="@(!_summaries.Any(s => s.EvaluationsReceivedCount > 0))"
                                @onclick="() => _confirmDeleteAllEvals = true">
                            Eliminar todas las calificaciones
                        </button>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-1 bg-danger-subtle px-2 py-1 rounded">
                            <span class="small text-danger fw-semibold">¿Borrar todas?</span>
                            <button class="btn btn-danger btn-sm py-0" @onclick="DeleteAllEvaluationsAsync">Sí, eliminar</button>
                            <button class="btn btn-secondary btn-sm py-0" @onclick="() => _confirmDeleteAllEvals = false">Cancelar</button>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_exportError))
            {
                <div class="alert alert-danger py-2 small">@_exportError</div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Estudiante</th>
                                <th>Carrera</th>
                                <th>Tema de Tesis</th>
                                <th class="text-center">Recibidas</th>
                                <th class="text-center">Realizadas</th>
                                <th class="text-center">Promedio</th>
                                <th>Clasificación</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _summaries)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@row.Student.Id</span></td>
                                    <td class="fw-semibold">@row.Student.Nombre</td>
                                    <td class="small">@row.Student.Carrera</td>
                                    <td class="small">@row.Student.TemaTesis</td>
                                    <td class="text-center">@row.EvaluationsReceivedCount</td>
                                    <td class="text-center">@row.EvaluationsGivenCount</td>
                                    <td class="text-center fw-bold">
                                        @(row.EvaluationsReceivedCount > 0 ? row.AverageScore.ToString("0.00") : "-")
                                    </td>
                                    <td>@row.Classification</td>
                                    <td>
                                        @if (row.EvaluationsReceivedCount == 0)
                                        {
                                            <span class="badge bg-secondary">Pendiente</span>
                                        }
                                        else if (row.Approved)
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Reprobado</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button class="btn btn-outline-success btn-sm"
                                                    disabled="@(row.EvaluationsReceivedCount == 0)"
                                                    @onclick="() => ExportStudentRubricAsync(row.Student.Id)">
                                                Rúbrica (.xlsx)
                                            </button>
                                            <button class="btn btn-outline-primary btn-sm"
                                                    disabled="@(row.EvaluationsReceivedCount == 0)"
                                                    @onclick="() => ViewDetailsAsync(row.Student)">
                                                Ver Detalle
                                            </button>
                                            @if (_confirmClearStudentId == row.Student.Id)
                                            {
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteStudentEvaluationsAsync(row.Student.Id)">
                                                    Confirmar
                                                </button>
                                                <button class="btn btn-secondary btn-sm" @onclick="() => _confirmClearStudentId = null">
                                                    Cancelar
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-danger btn-sm"
                                                        disabled="@(row.EvaluationsReceivedCount == 0)"
                                                        @onclick="() => _confirmClearStudentId = row.Student.Id">
                                                    Limpiar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (_detailStudent != null)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-brand d-flex justify-content-between align-items-center">
                        <strong>Detalle de Evaluaciones: @_detailStudent.Nombre (@_detailStudent.Id)</strong>
                        <button class="btn btn-sm btn-light" @onclick="() => _detailStudent = null">Cerrar</button>
                    </div>
                    <div class="card-body">
                        @foreach (var eval in _detailEvaluations)
                        {
                            bool evalApproved = eval.TotalScore >= _evalState.MinPassingScore;
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                    <div>
                                        <strong>Evaluador:</strong> @eval.Evaluator?.Nombre (@eval.EvaluatorId)
                                        <span class="text-muted small ms-2">@eval.CreatedAt.AddHours(-4).ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div>
                                        <span class="badge bg-dark me-1">@eval.TotalScore.ToString("0.00") / 100</span>
                                        <span class="badge @(evalApproved ? "bg-success" : "bg-danger") me-2">
                                            @eval.Classification
                                        </span>
                                        <button class="btn btn-outline-success btn-sm me-1" @onclick="() => ExportSingleEvaluationRubricAsync(eval.Id)">
                                            Rúbrica (.xlsx)
                                        </button>
                                        @if (_confirmDeleteEvalId == eval.Id)
                                        {
                                            <button class="btn btn-danger btn-sm me-1" @onclick="() => DeleteSingleEvaluationAsync(eval.Id)">
                                                Confirmar
                                            </button>
                                            <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteEvalId = null">
                                                Cancelar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmDeleteEvalId = eval.Id">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="row g-2 small">
                                    @foreach (var c in _criterionConfigs)
                                    {
                                        var d = eval.Details.FirstOrDefault(x => x.CriterionKey == c.Key);
                                        if (d != null)
                                        {
                                            <div class="col-md-4">
                                                <div class="p-2 bg-light rounded">
                                                    <strong>@c.ShortName:</strong> @d.WeightedPoints.ToString("0.00") / @c.Weight (Nivel @d.Score)
                                                    @if (!string.IsNullOrWhiteSpace(d.Evidence))
                                                    {
                                                        <div class="text-muted fst-italic mt-1">"@d.Evidence"</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (_activeTab == 2)
        {
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Parámetros de Evaluación y Seguridad</h5>

                            @if (!string.IsNullOrEmpty(_settingsMessage))
                            {
                                <div class="alert alert-info py-2 small">@_settingsMessage</div>
                            }

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nombre del Profesor (para la Rúbrica)</label>
                                <input type="text" class="form-control"
                                       placeholder="Ricardo Cesar Reinoso Rodriguez"
                                       @bind="_teacherName" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Carrera / Programa (Encabezado de Rúbrica)</label>
                                <input type="text" class="form-control"
                                       placeholder="Maestría en Enseñanza de la Matemática en el Nivel Secundario"
                                       @bind="_programName" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mínimo aprobatorio (0 - 100)</label>
                                <input type="number" step="0.5" min="0" max="100" class="form-control"
                                       @bind="_minPassingScore" />
                                <div class="form-text">Puntaje mínimo requerido para marcar a un estudiante como Aprobado.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nueva contraseña / PIN de docente (opcional)</label>
                                <input type="password" class="form-control"
                                       placeholder="Dejar vacío para mantener la actual"
                                       @bind="_newPinInput" />
                            </div>

                            <button class="btn btn-primary" @onclick="SaveSettingsAsync">
                                Guardar Configuración
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-danger">
                        <div class="card-body">
                            <h5 class="fw-bold text-danger mb-2">Resetear Sistema desde 0</h5>
                            <p class="text-muted small mb-3">
                                Elimina permanentemente todo el listado de estudiantes, todas las evaluaciones registradas
                                y cierra cualquier evaluación activa.
                            </p>

                            @if (!_confirmReset)
                            {
                                <button class="btn btn-outline-danger" @onclick="() => _confirmReset = true">
                                    Eliminar listado y resetear todo
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-danger py-2 small">
                                    <strong>¿Estás seguro?</strong> Esta acción no se puede deshacer.
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-danger" @onclick="ResetAllAsync">
                                        Sí, eliminar todo
                                    </button>
                                    <button class="btn btn-secondary" @onclick="() => _confirmReset = false">
                                        Cancelar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <div>
                            <h5 class="fw-bold mb-0">Criterios de Evaluación y Pesos (%)</h5>
                            <span class="text-muted small">Ajusta el nombre, etiqueta, peso (%) o desactiva criterios. La suma activa debe ser 100%.</span>
                        </div>
                        @{
                            double activeSum = Math.Round(_criterionConfigs.Where(c => c.IsActive).Sum(c => c.Weight), 2);
                        }
                        <span class="badge @(Math.Abs(activeSum - 100.0) <= 0.01 ? "bg-success" : "bg-danger") fs-6">
                            Total Activo: @activeSum.ToString("0.##")%
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(_criteriaMessage))
                    {
                        <div class="alert alert-info py-2 small">@_criteriaMessage</div>
                    }

                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Activo</th>
                                    <th>Nombre Corto</th>
                                    <th>Título Completo</th>
                                    <th>Etiqueta</th>
                                    <th style="width: 110px;">Peso (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cfg in _criterionConfigs)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" @bind="cfg.IsActive" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="cfg.ShortName" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="cfg.FullTitle" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="cfg.ChapterTag" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.5" min="0" max="100" class="form-control form-control-sm" @bind="cfg.Weight" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-primary btn-sm" @onclick="SaveCriteriaAsync">
                            Guardar Criterios y Pesos
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetCriteriaAsync">
                            Restaurar valores por defecto
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string _pinInput = string.Empty;
    private string? _pinError;
    private int _activeTab = 0;

    private List<Student> _students = new();
    private List<StudentSummary> _summaries = new();
    private string _searchTerm = string.Empty;

    private Student _newStudent = new();
    private string? _formMessage;
    private bool _isUploading;
    private ImportResult? _importResult;

    private Student? _detailStudent;
    private List<Evaluation> _detailEvaluations = new();

    private EvaluationState _evalState = new();
    private Student? _activeStudent;
    private string _selectedActiveStudentId = string.Empty;
    private string? _orchestrationMessage;

    private double _minPassingScore = 70.0;
    private string _teacherName = "Ricardo Cesar Reinoso Rodriguez";
    private string _programName = "Maestría en Enseñanza de la Matemática en el Nivel Secundario";
    private string _newPinInput = string.Empty;
    private string? _settingsMessage;
    private string? _exportError;
    private bool _confirmReset;
    private bool _confirmDeleteAllEvals;
    private string? _confirmClearStudentId;
    private string? _confirmDeleteStudentId;
    private int? _confirmDeleteEvalId;

    private List<Student> _pendingEvaluators = new();
    private int _activeReceivedCount;
    private int _activeEligibleCount;
    private bool _showPendingList;
    private System.Threading.Timer? _liveTimer;
    private bool _disposed;
    private bool _isRefreshingLive;

    private List<CriterionConfig> _criterionConfigs = new();
    private string? _criteriaMessage;

    private IEnumerable<Student> FilteredStudents =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _students
            : _students.Where(s =>
                s.Id.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsTeacherAuthenticated)
        {
            await LoadDataAsync();
        }
    }

    private async Task HandlePinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyPin();
    }

    private async Task VerifyPin()
    {
        if (await EvalService.ValidateTeacherPinAsync(_pinInput))
        {
            Session.IsTeacherAuthenticated = true;
            _pinError = null;
            await LoadDataAsync();
        }
        else
        {
            _pinError = "PIN incorrecto.";
        }
    }

    private void LogoutTeacher()
    {
        StopLiveTimer();
        Session.IsTeacherAuthenticated = false;
        _pinInput = string.Empty;
    }

    private async Task SwitchTab(int tab)
    {
        _activeTab = tab;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _students = await EvalService.GetAllStudentsAsync();
        _summaries = await EvalService.GetTeacherSummariesAsync();
        _criterionConfigs = await EvalService.GetCriterionConfigsAsync();
        var (state, active) = await EvalService.GetEvaluationStateAsync();
        _evalState = state;
        _activeStudent = active;
        _minPassingScore = state.MinPassingScore;
        _teacherName = state.TeacherName;
        _programName = state.ProgramName;
        if (string.IsNullOrEmpty(_selectedActiveStudentId) && !string.IsNullOrEmpty(state.ActiveStudentId))
        {
            _selectedActiveStudentId = state.ActiveStudentId;
        }
        await RefreshLiveProgressInternalAsync();
        SyncLiveTimer();
    }

    private async Task RefreshLiveProgressInternalAsync()
    {
        if (_evalState.IsOpen && _activeStudent != null)
        {
            var activeEvals = await EvalService.GetEvaluationsForStudentAsync(_activeStudent.Id);
            var doneIds = activeEvals.Select(e => e.EvaluatorId).ToHashSet();
            _pendingEvaluators = _students
                .Where(s => s.Id != _activeStudent.Id && !doneIds.Contains(s.Id))
                .ToList();
            _activeEligibleCount = Math.Max(0, _students.Count - 1);
            _activeReceivedCount = _activeEligibleCount - _pendingEvaluators.Count;
        }
        else
        {
            _pendingEvaluators.Clear();
            _activeEligibleCount = 0;
            _activeReceivedCount = 0;
            _showPendingList = false;
        }
    }

    private void SyncLiveTimer()
    {
        if (Session.IsTeacherAuthenticated && !_disposed)
        {
            _liveTimer ??= new System.Threading.Timer(_ =>
            {
                if (_disposed || _isRefreshingLive) return;
                _ = InvokeAsync(async () =>
                {
                    if (_disposed || _isRefreshingLive || !Session.IsTeacherAuthenticated) return;
                    _isRefreshingLive = true;
                    try
                    {
                        _summaries = await EvalService.GetTeacherSummariesAsync();
                        var (state, active) = await EvalService.GetEvaluationStateAsync();
                        _evalState = state;
                        _activeStudent = active;
                        await RefreshLiveProgressInternalAsync();
                        if (_detailStudent != null)
                        {
                            _detailEvaluations = await EvalService.GetEvaluationsForStudentAsync(_detailStudent.Id);
                        }
                        StateHasChanged();
                    }
                    catch
                    {
                        // Ignore transient circuit/timer teardown races
                    }
                    finally
                    {
                        _isRefreshingLive = false;
                    }
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
        else
        {
            StopLiveTimer();
        }
    }

    private void StopLiveTimer()
    {
        _liveTimer?.Dispose();
        _liveTimer = null;
    }

    public void Dispose()
    {
        _disposed = true;
        StopLiveTimer();
    }

    private async Task StartEvaluationAsync()
    {
        var (ok, msg) = await EvalService.StartEvaluationAsync(_selectedActiveStudentId);
        _orchestrationMessage = msg;
        await LoadDataAsync();
    }

    private async Task CloseEvaluationAsync()
    {
        await EvalService.CloseEvaluationAsync();
        _orchestrationMessage = "Evaluación cerrada.";
        await LoadDataAsync();
    }

    private async Task SaveSettingsAsync()
    {
        var (ok, msg) = await EvalService.UpdateSettingsAsync(_minPassingScore, _newPinInput, _teacherName, _programName);
        _settingsMessage = msg;
        if (ok)
        {
            _newPinInput = string.Empty;
            await LoadDataAsync();
        }
    }

    private async Task ResetAllAsync()
    {
        await EvalService.ResetAllDataAsync();
        _confirmReset = false;
        _selectedActiveStudentId = string.Empty;
        _detailStudent = null;
        _settingsMessage = "Sistema reseteado desde 0 correctamente.";
        await LoadDataAsync();
    }

    private async Task SaveCriteriaAsync()
    {
        var (ok, msg) = await EvalService.SaveCriterionConfigsAsync(_criterionConfigs);
        _criteriaMessage = msg;
        if (ok) await LoadDataAsync();
    }

    private async Task ResetCriteriaAsync()
    {
        await EvalService.ResetCriterionConfigsAsync();
        _criteriaMessage = "Criterios restaurados a los valores por defecto.";
        await LoadDataAsync();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        _isUploading = true;
        _importResult = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            _importResult = await ImportService.ImportFromStreamAsync(stream, file.Name);
            await LoadDataAsync();
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task DownloadTemplateAsync()
    {
        var bytes = ImportService.GenerateTemplateExcel();
        await JS.InvokeVoidAsync("downloadFileFromBytes", "Plantilla_Estudiantes.xlsx", Convert.ToBase64String(bytes));
    }

    private async Task SaveStudentAsync()
    {
        var (ok, msg) = await EvalService.AddOrUpdateStudentAsync(_newStudent);
        _formMessage = msg;
        if (ok)
        {
            _newStudent = new Student();
            await LoadDataAsync();
        }
    }

    private async Task DeleteStudentAsync(string id)
    {
        _confirmDeleteStudentId = null;
        await EvalService.DeleteStudentAsync(id);
        await LoadDataAsync();
    }

    private async Task ViewDetailsAsync(Student student)
    {
        _detailStudent = student;
        _detailEvaluations = await EvalService.GetEvaluationsForStudentAsync(student.Id);
    }

    private async Task RefreshResultsAsync()
    {
        await LoadDataAsync();
        if (_detailStudent != null)
        {
            _detailEvaluations = await EvalService.GetEvaluationsForStudentAsync(_detailStudent.Id);
        }
    }

    private async Task DeleteSingleEvaluationAsync(int evaluationId)
    {
        _confirmDeleteEvalId = null;
        await EvalService.DeleteEvaluationAsync(evaluationId);
        await RefreshResultsAsync();
    }

    private async Task DeleteStudentEvaluationsAsync(string evaluatedId)
    {
        _confirmClearStudentId = null;
        await EvalService.DeleteEvaluationsForStudentAsync(evaluatedId);
        if (_detailStudent?.Id == evaluatedId)
        {
            _detailStudent = null;
            _detailEvaluations.Clear();
        }
        await LoadDataAsync();
    }

    private async Task DeleteAllEvaluationsAsync()
    {
        _confirmDeleteAllEvals = false;
        await EvalService.DeleteAllEvaluationsAsync();
        _detailStudent = null;
        _detailEvaluations.Clear();
        await LoadDataAsync();
    }

    private async Task ExportExcelAsync()
    {
        _exportError = null;
        var bytes = await EvalService.ExportResultsExcelAsync();
        await JS.InvokeVoidAsync("downloadFileFromBytes", "Resultados_Heteroevaluacion.xlsx", Convert.ToBase64String(bytes));
    }

    private async Task ExportStudentRubricAsync(string evaluatedId)
    {
        _exportError = null;
        try
        {
            var result = await EvalService.ExportStudentRubricExcelAsync(evaluatedId);
            if (result == null)
            {
                _exportError = "El estudiante seleccionado no tiene evaluaciones registradas.";
                return;
            }
            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                result.Value.FileName,
                Convert.ToBase64String(result.Value.Bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            _exportError = $"Error al generar la rúbrica: {ex.Message}";
        }
    }

    private async Task ExportSingleEvaluationRubricAsync(int evaluationId)
    {
        _exportError = null;
        try
        {
            var result = await EvalService.ExportSingleEvaluationRubricExcelAsync(evaluationId);
            if (result == null)
            {
                _exportError = "No se encontró la evaluación solicitada.";
                return;
            }
            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                result.Value.FileName,
                Convert.ToBase64String(result.Value.Bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            _exportError = $"Error al generar la rúbrica individual: {ex.Message}";
        }
    }

    private async Task ExportAllRubricsZipAsync()
    {
        _exportError = null;
        try
        {
            var result = await EvalService.ExportAllRubricsZipAsync();
            if (result == null)
            {
                _exportError = "No hay estudiantes evaluados para exportar.";
                return;
            }
            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                result.Value.FileName,
                Convert.ToBase64String(result.Value.Bytes),
                "application/zip");
        }
        catch (Exception ex)
        {
            _exportError = $"Error al generar el archivo ZIP de rúbricas: {ex.Message}";
        }
    }
