@page "/maestro"
@rendermode InteractiveServer
@implements IDisposable
@using HeteroevaluacionApp.Components.Backoffice
@using HeteroevaluacionApp.Models
@using HeteroevaluacionApp.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ClassService ClassSvc
@inject EvaluationService EvalService
@inject SessionService Session
@inject ProtectedSessionStorage SessionStorage

<PageTitle>Panel Docente - Heteroevaluación</PageTitle>

@if (!Session.IsTeacherAuthenticated)
{
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card portal-card-teacher">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-2" style="color: #1F3864;">Panel Docente</h3>
                        <p class="text-muted small mb-4">
                            Ingresa tu PIN de docente para administrar clases, equipos de trabajo, rondas en vivo y resultados.
                        </p>

                        @if (!string.IsNullOrEmpty(_pinError))
                        {
                            <div class="alert alert-danger py-2">@_pinError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">PIN de Acceso</label>
                            <input type="password" class="form-control form-control-lg"
                                   placeholder="PIN docente"
                                   @bind="_pinInput"
                                   @bind:event="oninput"
                                   @onkeydown="HandlePinKeyDown" />
                        </div>

                        <button class="btn btn-accent w-100 btn-lg" @onclick="VerifyPinAsync">
                            Ingresar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h2 class="fw-bold mb-0" style="color: #1F3864;">Panel Docente</h2>
                <span class="text-muted small">Flujo guiado multi-clase: sala en vivo, nómina, analítica y rúbricas</span>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LogoutTeacherAsync">Cerrar sesión</button>
        </div>

        <ClassSelectorBar Classes="_classes"
                          SelectedClassId="_selectedClassId"
                          ActiveClass="_activeClass"
                          StudentCount="_students.Count"
                          GroupCount="_groups.Count"
                          ShowClassesHub="_showClassesHub"
                          QrRequestClass="_qrRequestClass"
                          OnClassSelected="SelectClassAsync"
                          OnToggleClassesHub="() => _showClassesHub = !_showClassesHub"
                          OnQrClosed="() => _qrRequestClass = null" />

        @if (_showClassesHub)
        {
            <ClassesHubView Classes="_classes"
                            SelectedClassId="_selectedClassId"
                            OnOpenClass="OpenClassFromHubAsync"
                            OnClassCreated="OpenClassFromHubAsync"
                            OnShowQr="cls => _qrRequestClass = cls"
                            OnChanged="ReloadClassDataAsync" />
        }
        else if (_activeClass != null)
        {
            <div @key="_activeClass.Id">
                <div class="workflow-tabs mb-4">
                    <button type="button"
                            class="workflow-tab-btn @(_activeTab == 0 ? "active" : "")"
                            @onclick="() => SwitchTabAsync(0)">
                        1. Sala en Vivo
                    </button>
                    <button type="button"
                            class="workflow-tab-btn @(_activeTab == 1 ? "active" : "")"
                            @onclick="() => SwitchTabAsync(1)">
                        2. Nómina y Equipos (@_students.Count est. · @_groups.Count grp.)
                    </button>
                    <button type="button"
                            class="workflow-tab-btn @(_activeTab == 2 ? "active" : "")"
                            @onclick="() => SwitchTabAsync(2)">
                        3. Calificaciones y Analítica
                    </button>
                    <button type="button"
                            class="workflow-tab-btn @(_activeTab == 3 ? "active" : "")"
                            @onclick="() => SwitchTabAsync(3)">
                        4. Ficha y Rúbrica
                    </button>
                </div>

                @if (_activeTab == 0)
                {
                    <LiveOrchestrationTab ActiveClass="_activeClass"
                                          Students="_students"
                                          Groups="_groups"
                                          StudentSummaries="_studentSummaries"
                                          GroupSummaries="_groupSummaries"
                                          ActiveRound="_activeRound"
                                          RoundProgress="_roundProgress"
                                          OnChanged="ReloadClassDataAsync"
                                          OnOpenQrModal="() => _qrRequestClass = _activeClass" />
                }
                else if (_activeTab == 1)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    class="btn btn-sm @(_peopleSubTab == 0 ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => _peopleSubTab = 0">
                                Estudiantes (@_students.Count)
                            </button>
                            <button type="button"
                                    class="btn btn-sm @(_peopleSubTab == 1 ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => _peopleSubTab = 1">
                                Equipos de Trabajo (@_groups.Count)
                            </button>
                        </div>
                        <span class="small text-muted">
                            <strong>@_students.Count(s => s.WorkGroupId != null)</strong> en grupo ·
                            <strong>@_students.Count(s => s.WorkGroupId == null)</strong> individuales
                        </span>
                    </div>

                    @if (_peopleSubTab == 0)
                    {
                        <StudentsTab ClassRoomId="_activeClass.Id"
                                     Students="_students"
                                     Groups="_groups"
                                     StudentSummaries="_studentSummaries"
                                     OnLaunchStudent="LaunchStudentRoundAsync"
                                     OnChanged="ReloadClassDataAsync" />
                    }
                    else
                    {
                        <GroupsTab ClassRoomId="_activeClass.Id"
                                   Students="_students"
                                   Groups="_groups"
                                   GroupSummaries="_groupSummaries"
                                   OnLaunchGroup="LaunchGroupRoundAsync"
                                   OnChanged="ReloadClassDataAsync" />
                    }
                }
                else if (_activeTab == 2)
                {
                    <ResultsTab ActiveClass="_activeClass"
                                StudentSummaries="_studentSummaries"
                                GroupSummaries="_groupSummaries"
                                CriterionConfigs="_criterionConfigs"
                                CriterionAnalytics="_criterionAnalytics"
                                DetailStudent="_detailStudent"
                                DetailEvaluations="_detailEvaluations"
                                DetailGroup="_detailGroup"
                                DetailGroupSubmissions="_detailGroupSubmissions"
                                OnSelectDetailStudent="SelectDetailStudentAsync"
                                OnSelectDetailGroup="SelectDetailGroupAsync"
                                OnChanged="ReloadClassDataAsync" />
                }
                else if (_activeTab == 3)
                {
                    <SettingsTab ActiveClass="_activeClass"
                                 CriterionConfigs="_criterionConfigs"
                                 OnChanged="ReloadClassDataAsync"
                                 OnClassDuplicated="SelectClassAsync"
                                 OnClassDeleted="HandleClassDeletedAsync" />
                }
            </div>
        }
    </div>
}

@code {
    private record TeacherAuthState(bool IsAuthenticated, int? SelectedClassId);

    private string _pinInput = string.Empty;
    private string? _pinError;
    private int _activeTab = 0;
    private int _peopleSubTab = 0;
    private bool _showClassesHub;
    private ClassRoom? _qrRequestClass;

    private List<ClassRoom> _classes = new();
    private int _selectedClassId;
    private ClassRoom? _activeClass;

    private List<Student> _students = new();
    private List<WorkGroup> _groups = new();
    private List<CriterionConfig> _criterionConfigs = new();
    private List<StudentSummary> _studentSummaries = new();
    private List<GroupSummary> _groupSummaries = new();
    private List<CriterionAnalyticsItem> _criterionAnalytics = new();
    private ActiveRoundInfo _activeRound = new(false, null, null, new(), string.Empty, null);
    private ActiveRoundProgress _roundProgress = new(0, 0, new(), new());

    private Student? _detailStudent;
    private List<Evaluation> _detailEvaluations = new();
    private WorkGroup? _detailGroup;
    private List<GroupSubmissionDetail> _detailGroupSubmissions = new();

    private System.Threading.Timer? _liveTimer;
    private bool _disposed;
    private bool _isRefreshingLive;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsTeacherAuthenticated)
        {
            await InitializeClassesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Session.IsTeacherAuthenticated)
        {
            try
            {
                var stored = await SessionStorage.GetAsync<TeacherAuthState>("hetero_teacher_auth");
                if (stored.Success && stored.Value?.IsAuthenticated == true)
                {
                    Session.IsTeacherAuthenticated = true;
                    if (stored.Value.SelectedClassId.HasValue)
                        Session.SelectedClassId = stored.Value.SelectedClassId.Value;
                    await InitializeClassesAsync();
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore prerender or expired data protection key gracefully
            }
        }
    }

    private async Task PersistTeacherSessionAsync()
    {
        try
        {
            await SessionStorage.SetAsync("hetero_teacher_auth", new TeacherAuthState(Session.IsTeacherAuthenticated, Session.SelectedClassId));
        }
        catch
        {
            // Ignore transient JS interop failure
        }
    }

    private async Task HandlePinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyPinAsync();
    }

    private async Task VerifyPinAsync()
    {
        if (await EvalService.ValidateTeacherPinAsync(_pinInput))
        {
            Session.IsTeacherAuthenticated = true;
            _pinError = null;
            await InitializeClassesAsync();
            await PersistTeacherSessionAsync();
        }
        else
        {
            _pinError = "PIN incorrecto.";
        }
    }

    private async Task LogoutTeacherAsync()
    {
        StopLiveTimer();
        Session.IsTeacherAuthenticated = false;
        _pinInput = string.Empty;
        _showClassesHub = false;
        try
        {
            await SessionStorage.DeleteAsync("hetero_teacher_auth");
        }
        catch
        {
            // Ignore transient JS interop failure
        }
    }

    private async Task InitializeClassesAsync()
    {
        _classes = await ClassSvc.GetAllClassesAsync();
        if (Session.SelectedClassId.HasValue && _classes.Any(c => c.Id == Session.SelectedClassId.Value))
        {
            _selectedClassId = Session.SelectedClassId.Value;
        }
        else if (_classes.Count > 0)
        {
            var firstActive = _classes.FirstOrDefault(c => !c.IsArchived) ?? _classes[0];
            _selectedClassId = firstActive.Id;
            Session.SelectedClassId = _selectedClassId;
        }
        await ReloadClassDataAsync();
    }

    private async Task OpenClassFromHubAsync(int classId)
    {
        _showClassesHub = false;
        await SelectClassAsync(classId);
    }

    private async Task SelectClassAsync(int classId)
    {
        _selectedClassId = classId;
        Session.SelectedClassId = classId;
        _detailStudent = null;
        _detailEvaluations.Clear();
        _detailGroup = null;
        _detailGroupSubmissions.Clear();
        _peopleSubTab = 0;
        await ReloadClassDataAsync();
        await PersistTeacherSessionAsync();
    }

    private async Task HandleClassDeletedAsync()
    {
        Session.SelectedClassId = null;
        _detailStudent = null;
        _detailEvaluations.Clear();
        _detailGroup = null;
        _detailGroupSubmissions.Clear();
        await InitializeClassesAsync();
        await PersistTeacherSessionAsync();
    }

    private async Task SwitchTabAsync(int tab)
    {
        _activeTab = tab;
        await ReloadClassDataAsync();
    }

    private async Task LaunchStudentRoundAsync(int studentId)
    {
        if (_activeClass == null) return;
        await EvalService.StartEvaluationRoundAsync(_activeClass.Id, new List<int> { studentId });
        _activeTab = 0;
        await ReloadClassDataAsync();
    }

    private async Task LaunchGroupRoundAsync(WorkGroup group)
    {
        if (_activeClass == null) return;
        var ids = group.Members.Select(m => m.Id).ToList();
        if (ids.Count == 0) return;
        await EvalService.StartEvaluationRoundAsync(_activeClass.Id, ids, group.Id, group.Name);
        _activeTab = 0;
        await ReloadClassDataAsync();
    }

    private async Task ReloadClassDataAsync()
    {
        _classes = await ClassSvc.GetAllClassesAsync();
        _activeClass = _classes.FirstOrDefault(c => c.Id == _selectedClassId) ?? _classes.FirstOrDefault();
        if (_activeClass == null) return;
        _selectedClassId = _activeClass.Id;
        Session.SelectedClassId = _selectedClassId;

        _students = await EvalService.GetAllStudentsAsync(_selectedClassId);
        _groups = await ClassSvc.GetGroupsForClassAsync(_selectedClassId);
        _criterionConfigs = await EvalService.GetCriterionConfigsAsync(_selectedClassId);
        _studentSummaries = await EvalService.GetStudentSummariesAsync(_selectedClassId);
        _groupSummaries = await EvalService.GetGroupSummariesAsync(_selectedClassId);
        _criterionAnalytics = await EvalService.GetClassCriterionAnalyticsAsync(_selectedClassId);
        _activeRound = await EvalService.GetActiveRoundAsync(_selectedClassId);
        _roundProgress = await EvalService.GetActiveRoundProgressAsync(_selectedClassId);

        if (_detailStudent != null)
        {
            _detailEvaluations = await EvalService.GetEvaluationsForStudentAsync(_detailStudent.Id);
        }
        if (_detailGroup != null)
        {
            _detailGroupSubmissions = await EvalService.GetGroupSubmissionDetailsAsync(_detailGroup.Id);
        }

        SyncLiveTimer();
    }

    private async Task SelectDetailStudentAsync(Student? student)
    {
        _detailStudent = student;
        _detailEvaluations = student != null
            ? await EvalService.GetEvaluationsForStudentAsync(student.Id)
            : new();
    }

    private async Task SelectDetailGroupAsync(WorkGroup? group)
    {
        _detailGroup = group;
        _detailGroupSubmissions = group != null
            ? await EvalService.GetGroupSubmissionDetailsAsync(group.Id)
            : new();
    }

    private void SyncLiveTimer()
    {
        if (Session.IsTeacherAuthenticated && _selectedClassId > 0 && !_disposed)
        {
            _liveTimer ??= new System.Threading.Timer(_ =>
            {
                if (_disposed || _isRefreshingLive) return;
                _ = InvokeAsync(async () =>
                {
                    if (_disposed || _isRefreshingLive || !Session.IsTeacherAuthenticated || _selectedClassId <= 0) return;
                    _isRefreshingLive = true;
                    try
                    {
                        _activeClass = await ClassSvc.GetClassByIdAsync(_selectedClassId);
                        _studentSummaries = await EvalService.GetStudentSummariesAsync(_selectedClassId);
                        _groupSummaries = await EvalService.GetGroupSummariesAsync(_selectedClassId);
                        _criterionAnalytics = await EvalService.GetClassCriterionAnalyticsAsync(_selectedClassId);
                        _activeRound = await EvalService.GetActiveRoundAsync(_selectedClassId);
                        _roundProgress = await EvalService.GetActiveRoundProgressAsync(_selectedClassId);
                        if (_detailStudent != null)
                        {
                            _detailEvaluations = await EvalService.GetEvaluationsForStudentAsync(_detailStudent.Id);
                        }
                        if (_detailGroup != null)
                        {
                            _detailGroupSubmissions = await EvalService.GetGroupSubmissionDetailsAsync(_detailGroup.Id);
                        }
                        StateHasChanged();
                    }
                    catch
                    {
                        // Ignore transient circuit/timer teardown races
                    }
                    finally
                    {
                        _isRefreshingLive = false;
                    }
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
        else
        {
            StopLiveTimer();
        }
    }

    private void StopLiveTimer()
    {
        _liveTimer?.Dispose();
        _liveTimer = null;
    }

    public void Dispose()
    {
        _disposed = true;
        StopLiveTimer();
    }
}
