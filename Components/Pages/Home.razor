@page "/"

<PageTitle>Heteroevaluación de Tesis</PageTitle>

<div class="container py-4 py-md-5">
    <div class="brand-hero text-center mb-4">
        <div>
            <span class="brand-badge mb-2">Evaluación Académica entre Pares</span>
        </div>
        <h1 class="display-6 fw-bold mt-2 mb-2" style="color: #1F3864;">
            Sistema de Heteroevaluación de Tesis
        </h1>
        <p class="lead text-muted mb-0 mx-auto" style="max-width: 640px;">
            Plataforma para la evaluación de trabajos finales entre pares, orquestada en vivo por el docente.
        </p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-5">
            <div class="card h-100 portal-card-student">
                <div class="card-body p-4 d-flex flex-column">
                    <h3 class="card-title fw-bold mb-2" style="color: #1F3864;">Portal de Estudiantes</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Accede con tu matrícula registrada para evaluar la exposición activa.
                        Solo puedes calificar una vez a cada compañero y no puedes evaluarte a ti mismo.
                    </p>
                    <a href="/estudiante" class="btn btn-primary btn-lg mt-3">
                        Ingresar como Estudiante
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 portal-card-teacher">
                <div class="card-body p-4 d-flex flex-column">
                    <h3 class="card-title fw-bold mb-2" style="color: #1F3864;">Backoffice del Maestro</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Carga el listado de estudiantes vía CSV o Excel, controla la ronda en vivo,
                        consulta promedios y descarga las rúbricas individuales completadas en formato Excel.
                    </p>
                    <a href="/maestro" class="btn btn-accent btn-lg mt-3">
                        Ingresar al Backoffice
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
