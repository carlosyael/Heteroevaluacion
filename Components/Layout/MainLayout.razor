@inherits LayoutComponentBase
@using HeteroevaluacionApp.Services
@inject SessionService Session

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex align-items-center gap-3 overflow-hidden">
                <span class="top-row-subtitle">
                    Sistema de Heteroevaluación de Tesis
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (Session.CurrentStudent != null)
                {
                    <span class="badge bg-primary-subtle text-primary border d-none d-md-inline-block">
                        @Session.CurrentStudent.Nombre (@Session.CurrentStudent.Matricula)
                    </span>
                }
                else if (Session.IsTeacherAuthenticated)
                {
                    <span class="badge bg-warning-subtle text-dark border d-none d-md-inline-block">
                        Modo Docente
                    </span>
                }
                <a href="/instructivo" class="top-row-guide">Instructivo</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
