@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex align-items-center gap-3 overflow-hidden">
                <img src="images/logo-unapec.png" alt="UNAPEC" class="top-row-logo" />
                <span class="top-row-subtitle d-none d-md-inline">
                    Decanato de Posgrado y Educación Continuada &middot; Heteroevaluación de Tesis
                </span>
            </div>
            <a href="/instructivo" class="top-row-guide">Instructivo</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
