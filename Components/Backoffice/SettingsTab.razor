@using HeteroevaluacionApp.Models
@using HeteroevaluacionApp.Services
@inject ClassService ClassSvc
@inject EvaluationService EvalSvc

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100 portal-card-student">
            <div class="card-body">
                <h5 class="fw-bold mb-3" style="color: #1F3864;">Ficha Académica y Temario</h5>

                @if (!string.IsNullOrEmpty(_classMsg))
                {
                    <div class="alert @(_classError ? "alert-danger" : "alert-info") py-2 small">@_classMsg</div>
                }

                <div class="row g-2 mb-2">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Nombre de la Clase</label>
                        <input type="text" class="form-control" @bind="_name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Código (URL)</label>
                        <input type="text" class="form-control" @bind="_code" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold">Profesor (para la Rúbrica)</label>
                    <input type="text" class="form-control" @bind="_teacherName" />
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold">Carrera / Programa (Encabezado de Rúbrica)</label>
                    <input type="text" class="form-control" @bind="_programName" />
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold">Temario de la Clase</label>
                    <textarea class="form-control" rows="4" @bind="_syllabus" placeholder="Unidades o temas principales del curso"></textarea>
                </div>

                <div class="row g-3 align-items-center mb-3">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Mínimo aprobatorio (0 - 100)</label>
                        <input type="number" step="0.5" min="0" max="100" class="form-control" @bind="_minPassingScore" />
                    </div>
                    <div class="col-md-7 pt-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="settingsPublishSwitch" @bind="_publishResults" />
                            <label class="form-check-label small fw-semibold" for="settingsPublishSwitch">
                                Publicar calificaciones y comentarios anónimos a estudiantes
                            </label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary" @onclick="SaveClassSettingsAsync">
                    Guardar Ficha de la Clase
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card portal-card-teacher">
            <div class="card-body">
                <h5 class="fw-bold mb-2" style="color: #1F3864;">Ciclo de Vida de la Clase</h5>
                <p class="text-muted small mb-3">
                    Reutiliza esta configuración en otro grupo/cuatrimestre o archiva la clase cuando concluya.
                </p>

                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-outline-primary btn-sm" @onclick="DuplicateClassAsync">
                        Duplicar configuración de esta clase (sin alumnos ni notas)
                    </button>
                    @if (ActiveClass != null)
                    {
                        <button class="btn @(ActiveClass.IsArchived ? "btn-outline-success" : "btn-outline-warning") btn-sm"
                                @onclick="ToggleArchiveClassAsync">
                            @(ActiveClass.IsArchived ? "Reactivar clase en el selector estudiantil" : "Archivar clase (ocultar a estudiantes)")
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card border-danger">
            <div class="card-body">
                <h5 class="fw-bold text-danger mb-2">Mantenimiento y Zona de Peligro</h5>
                <p class="text-muted small mb-3">
                    Estas acciones afectan únicamente a esta clase y no modifican las demás.
                </p>

                <div class="d-flex flex-column gap-2">
                    @if (!_confirmResetClass)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmResetClass = true">
                            Resetear clase desde 0 (estudiantes, grupos y notas)
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 small mb-0">
                            <strong>¿Resetear esta clase?</strong> Se eliminarán todos sus estudiantes, grupos y calificaciones.
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-danger btn-sm" @onclick="ResetClassAsync">Sí, resetear</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _confirmResetClass = false">Cancelar</button>
                            </div>
                        </div>
                    }

                    @if (!_confirmDeleteClass)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmDeleteClass = true">
                            Eliminar esta clase por completo
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 small mb-0">
                            <strong>¿Eliminar la clase '@ActiveClass?.Name'?</strong> Esta acción no se puede deshacer.
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-danger btn-sm" @onclick="DeleteClassAsync">Sí, eliminar</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDeleteClass = false">Cancelar</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h5 class="fw-bold mb-0" style="color: #1F3864;">Diseño de Ponderación de Rúbrica (Criterios y Pesos %)</h5>
                <span class="text-muted small">La suma de los criterios activos debe ser exactamente 100%.</span>
            </div>
            @{
                double activeSum = Math.Round(_editableCriteria.Where(c => c.IsActive).Sum(c => c.Weight), 2);
            }
            <span class="badge @(Math.Abs(activeSum - 100.0) <= 0.01 ? "bg-success" : "bg-danger") fs-6">
                Total Activo: @activeSum.ToString("0.##")%
            </span>
        </div>

        @if (!string.IsNullOrEmpty(_criteriaMsg))
        {
            <div class="alert @(_criteriaError ? "alert-danger" : "alert-info") py-2 small">@_criteriaMsg</div>
        }

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Activo</th>
                        <th>Nombre Corto</th>
                        <th>Título Completo</th>
                        <th>Etiqueta</th>
                        <th style="width: 110px;">Peso (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cfg in _editableCriteria)
                    {
                        <tr>
                            <td><input type="checkbox" class="form-check-input" @bind="cfg.IsActive" /></td>
                            <td><input type="text" class="form-control form-control-sm" @bind="cfg.ShortName" /></td>
                            <td><input type="text" class="form-control form-control-sm" @bind="cfg.FullTitle" /></td>
                            <td><input type="text" class="form-control form-control-sm" @bind="cfg.ChapterTag" /></td>
                            <td><input type="number" step="0.5" min="0" max="100" class="form-control form-control-sm" @bind="cfg.Weight" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-primary btn-sm" @onclick="SaveCriteriaAsync">Guardar Criterios y Pesos</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetCriteriaAsync">Restaurar valores por defecto</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ClassRoom? ActiveClass { get; set; }
    [Parameter, EditorRequired] public List<CriterionConfig> CriterionConfigs { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<int> OnClassDuplicated { get; set; }
    [Parameter] public EventCallback OnClassDeleted { get; set; }

    private int _loadedClassId;
    private string _name = string.Empty;
    private string _code = string.Empty;
    private string _teacherName = string.Empty;
    private string _programName = string.Empty;
    private string _syllabus = string.Empty;
    private double _minPassingScore = 70.0;
    private bool _publishResults;
    private List<CriterionConfig> _editableCriteria = new();

    private string? _classMsg;
    private bool _classError;
    private string? _criteriaMsg;
    private bool _criteriaError;
    private bool _confirmResetClass;
    private bool _confirmDeleteClass;

    protected override void OnParametersSet()
    {
        if (ActiveClass != null && ActiveClass.Id != _loadedClassId)
        {
            SyncFieldsFromParameters();
        }
    }

    private void SyncFieldsFromParameters()
    {
        if (ActiveClass == null) return;
        _loadedClassId = ActiveClass.Id;
        _name = ActiveClass.Name;
        _code = ActiveClass.Code;
        _teacherName = ActiveClass.TeacherName;
        _programName = ActiveClass.ProgramName;
        _syllabus = ActiveClass.Syllabus ?? string.Empty;
        _minPassingScore = ActiveClass.MinPassingScore;
        _publishResults = ActiveClass.PublishResultsToStudents;
        _editableCriteria = CriterionConfigs.Select(c => new CriterionConfig
        {
            Id = c.Id,
            ClassRoomId = c.ClassRoomId,
            Key = c.Key,
            Order = c.Order,
            ShortName = c.ShortName,
            FullTitle = c.FullTitle,
            ChapterTag = c.ChapterTag,
            Weight = c.Weight,
            IsActive = c.IsActive
        }).ToList();
        _confirmResetClass = false;
        _confirmDeleteClass = false;
    }

    private async Task SaveClassSettingsAsync()
    {
        if (ActiveClass == null) return;
        var (ok, msg) = await ClassSvc.UpdateClassDetailsAsync(
            ActiveClass.Id, _name, _code, _teacherName, _programName, _syllabus, _minPassingScore, _publishResults);
        _classError = !ok;
        _classMsg = msg;
        if (ok) await OnChanged.InvokeAsync();
    }

    private async Task DuplicateClassAsync()
    {
        if (ActiveClass == null) return;
        var (ok, msg, created) = await ClassSvc.DuplicateClassAsync(ActiveClass.Id);
        _classError = !ok;
        _classMsg = msg;
        if (ok && created != null)
        {
            await OnClassDuplicated.InvokeAsync(created.Id);
        }
    }

    private async Task ToggleArchiveClassAsync()
    {
        if (ActiveClass == null) return;
        var (ok, msg) = await ClassSvc.SetClassArchivedAsync(ActiveClass.Id, !ActiveClass.IsArchived);
        _classError = !ok;
        _classMsg = msg;
        await OnChanged.InvokeAsync();
    }

    private async Task ResetClassAsync()
    {
        if (ActiveClass == null) return;
        await ClassSvc.ResetClassDataAsync(ActiveClass.Id);
        _confirmResetClass = false;
        _classError = false;
        _classMsg = "Clase reseteada desde 0 correctamente.";
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteClassAsync()
    {
        if (ActiveClass == null) return;
        var (ok, msg) = await ClassSvc.DeleteClassAsync(ActiveClass.Id);
        _confirmDeleteClass = false;
        if (!ok)
        {
            _classError = true;
            _classMsg = msg;
            return;
        }
        _loadedClassId = 0;
        await OnClassDeleted.InvokeAsync();
    }

    private async Task SaveCriteriaAsync()
    {
        if (ActiveClass == null) return;
        var (ok, msg) = await EvalSvc.SaveCriterionConfigsAsync(ActiveClass.Id, _editableCriteria);
        _criteriaError = !ok;
        _criteriaMsg = msg;
        if (ok) await OnChanged.InvokeAsync();
    }

    private async Task ResetCriteriaAsync()
    {
        if (ActiveClass == null) return;
        await EvalSvc.ResetCriterionConfigsAsync(ActiveClass.Id);
        _criteriaError = false;
        _criteriaMsg = "Criterios restaurados a los valores por defecto.";
        _loadedClassId = 0;
        await OnChanged.InvokeAsync();
    }
}
